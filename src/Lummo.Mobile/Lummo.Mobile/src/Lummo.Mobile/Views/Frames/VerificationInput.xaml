<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lummo.Mobile.Views.Frames.VerificationInput">
    <Border StrokeThickness="{AppThemeBinding Light=0, Dark=1}"
                    StrokeShape="RoundRectangle 15"
                    HeightRequest="60"
                    WidthRequest="50"
                    Background="{AppThemeBinding Light=#f8fafc, Dark=#1e293b}">
        <Border.Stroke>
            <LinearGradientBrush  EndPoint="0,0.5">
                <GradientStop Color="{AppThemeBinding Light=#e2e8f0, Dark=#334155}" Offset="0"/>
                <GradientStop Color="{AppThemeBinding Light=#e2e8f0, Dark=#2d185a}" Offset="1"/>
            </LinearGradientBrush>
        </Border.Stroke>
        <Entry x:Name="CodeEntry"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               VerticalOptions="Center"
               FontAttributes="Bold"
               FontSize="20"
               MaxLength="1"
               Keyboard="Numeric"
               TextChanged="OnTextChanged"/>
    </Border>
</ContentView>
