<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lummo.Mobile.Views.Pages.DashboardPage"
             xmlns:ct="clr-namespace:Lummo.Mobile.Controls"
             Shell.NavBarIsVisible="False"
             ct:CustomStatusBarBehavior.StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush  EndPoint="0,0.5">
                <GradientStop Color="{AppThemeBinding Light=#e4dcfc, Dark=#231942}" Offset="0"/>
                <GradientStop Color="{AppThemeBinding Light=#f5f2fe, Dark=#2d185a}" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Label 
            Text="Welcome to Lummo. We are happy to see you here again!"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
    </Grid>
</ContentPage>