<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lummo.Mobile.Views.Pages.ResetPasswordPage"
             xmlns:vm="clr-namespace:Lummo.Mobile.ViewModels"
             xmlns:imgUiHelper="clr-namespace:Lummo.Mobile.UIHelpers"
             xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:ct="clr-namespace:Lummo.Mobile.Controls"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             Shell.NavBarIsVisible="False"
             x:DataType="vm:ResetPasswordPageViewModel"
             ct:CustomStatusBarBehavior.StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}">
    <Grid>
        <ScrollView>
            <Grid RowDefinitions="80,*">
                <Grid.Background>
                    <LinearGradientBrush  EndPoint="0,1">
                        <GradientStop Color="{AppThemeBinding Light=#e4dcfc, Dark=#231942}" Offset="0"/>
                        <GradientStop Color="{AppThemeBinding Light=#f5f2fe, Dark=#2d185a}" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>