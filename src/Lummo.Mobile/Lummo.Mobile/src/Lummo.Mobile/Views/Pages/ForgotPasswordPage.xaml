<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lummo.Mobile.Views.Pages.ForgotPasswordPage"
             xmlns:vm="clr-namespace:Lummo.Mobile.ViewModels"
             xmlns:imgUiHelper="clr-namespace:Lummo.Mobile.UIHelpers"
             xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:ct="clr-namespace:Lummo.Mobile.Controls"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             Shell.NavBarIsVisible="False"
             x:DataType="vm:ForgotPasswordPageViewModel"
             ct:CustomStatusBarBehavior.StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}">
    <Grid>
        <ScrollView>
            <Grid RowDefinitions="80,*">
                <Grid.Background>
                    <LinearGradientBrush  EndPoint="0,1">
                        <GradientStop Color="{AppThemeBinding Light=#e4dcfc, Dark=#231942}" Offset="0"/>
                        <GradientStop Color="{AppThemeBinding Light=#f5f2fe, Dark=#2d185a}" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>

                <Grid Grid.Row="0" VerticalOptions="End">
                    <Border StrokeThickness="0"
                            StrokeShape="Rectangle 20"
                            HeightRequest="50"
                            WidthRequest="50"
                            Padding="15"
                            VerticalOptions="Center"
                            HorizontalOptions="Start">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GotoBackCommand}"/>
                        </Border.GestureRecognizers>
                        <Image Source="arrow.png"
                            Aspect="AspectFit"
                            imgUiHelper:ImageThemeHelper.UseThemeColor="True"
                            imgUiHelper:ImageThemeHelper.LightColor="#000000"
                            imgUiHelper:ImageThemeHelper.DarkColor="#ffffff"/>

                    </Border>

                    <Label Grid.Column="1"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center"
                        Text="Reset your password"
                        FontSize="22"
                        FontFamily="PoppinsMedium"
                        FontAttributes="Bold"/>
                </Grid>

                <!--#region Body-->
                <Grid Grid.Row="1" RowDefinitions="*, Auto, Auto, Auto, *,Auto, Auto">
                    
                    <Border Grid.Row="0" VerticalOptions="End" HorizontalOptions="Center"
                            Padding="50"
                            StrokeThickness="0">
                        <Image Source="forgot.png"
                               Aspect="AspectFit"
                               HeightRequest="150"
                               />
                    </Border>
                    <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" HorizontalOptions="Center">

                        <Label VerticalOptions="Center" HorizontalTextAlignment="Center"
                           Text="Forgot Password?"
                           FontSize="30"
                           FontFamily="PoppinsMedium"
                           FontAttributes="Bold"/>

                        <Label VerticalOptions="Center" HorizontalTextAlignment="Center"
                               Text="Enter your email address and we'll send you a 6-digit code to reset your password."
                               FontSize="16"
                               FontFamily="PoppinsLight"
                               Margin="30,0"
                               TextColor="#64748b"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="2" Spacing="5" Margin="30,30,30,0">
                        <Label Text="Email Address"
                               FontFamily="PoppinsMedium"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light=#424f62, Dark=#f3f4f6}"
                               FontAttributes="Bold"/>
                        <Border StrokeThickness="{Binding IsEmailAdddressNotInputOrNotCorrect}"
                                StrokeShape="RoundRectangle 30"
                                Stroke="Red"
                                Padding="0">
                            <Border StrokeThickness="{AppThemeBinding Light=0, Dark=1}"
                                    StrokeShape="RoundRectangle 30"
                                    Background="{AppThemeBinding Light=#f8fafc, Dark=#1e293b}" 
                                    Padding="20,5,5,5">
                                <Border.Stroke>
                                    <LinearGradientBrush  EndPoint="0,0.5">
                                        <GradientStop Color="{AppThemeBinding Light=#e2e8f0, Dark=#334155}" Offset="0"/>
                                        <GradientStop Color="{AppThemeBinding Light=#e2e8f0, Dark=#2d185a}" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Stroke>
                                <Grid ColumnDefinitions="30, *" ColumnSpacing="5">
                                    <Image Grid.Column="0" Source="envelope"
                                           HeightRequest="25"
                                           WidthRequest="25"
                                           VerticalOptions="Center"
                                           HorizontalOptions="Center">
                                        <Image.Behaviors>
                                            <mct:IconTintColorBehavior TintColor="#94a3b8"/>
                                        </Image.Behaviors>
                                    </Image>

                                    <Entry Grid.Column="1"
                                           Placeholder="student@example.com"
                                           PlaceholderColor="#97a5ba"
                                           FontSize="18"
                                           FontFamily="Poppins"
                                           TextChanged="EmailAddress_TextChanged"
                                           Text="{Binding Email}"
                                           Keyboard="Email"/>
                                </Grid>
                            </Border>
                        </Border>
                        <!-- General error (backend / network) -->
                        <Border IsVisible="{Binding HasGeneralError}"
                                StrokeShape="RoundRectangle 15"
                                StrokeThickness="0"
                                Background="#fff1f2"
                                Padding="16,12">
                            <Grid ColumnDefinitions="24,*" ColumnSpacing="10">
                                <Label Grid.Column="0" Text="⚠️"
                                        FontSize="16" VerticalOptions="Center"/>
                                <Label Grid.Column="1"
                                       Text="{Binding GeneralError}"
                                       TextColor="#b91c1c"
                                       FontFamily="Poppins"
                                       FontSize="14"
                                       LineBreakMode="WordWrap"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <Border Grid.Row="3" Background="#4913ec"
                            StrokeShape="RoundRectangle 25"
                            StrokeThickness="0"
                            Margin="30,30,30,0"
                            Padding="15"
                            Opacity="{Binding IsBusy, Converter={mct:InvertedBoolConverter}}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SendCodeCommand}"/>
                        </Border.GestureRecognizers>
                        <Border.Shadow>
                            <Shadow Brush="DarkBlue" Offset="0,2" Opacity="0.5"/>
                        </Border.Shadow>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" HorizontalOptions="Center">
                            <Label Grid.Column="0"
                                   Text="Send Code"
                                   TextColor="White"
                                   FontFamily="Poppins"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="End"
                                   VerticalTextAlignment="Center"/>
                            <Image Grid.Column="1" Source="arrow_right.png"
                                   HeightRequest="25" WidthRequest="25"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Center">
                                <Image.Behaviors>
                                    <mct:IconTintColorBehavior TintColor="#ffffff"/>
                                </Image.Behaviors>
                            </Image>
                        </Grid>
                    </Border>

                    <Label Grid.Row="5" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" Margin="0,30,0,00">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Remember your password? "
                                      TextColor="{AppThemeBinding Light=#424f62, Dark=#f3f4f6}"
                                      FontFamily="Poppins"
                                      FontSize="18"/>
                                <Span Text="LogIn"
                                      FontAttributes="Bold"
                                      TextColor="#4a14ec"
                                      FontFamily="Poppins"
                                      FontSize="18">
                                    <Span.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GotoBackCommand}"/>
                                    </Span.GestureRecognizers>
                                </Span>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <!-- Bottom spacer -->
                    <BoxView Grid.Row="6" Background="Transparent" VerticalOptions="Start">
                        <BoxView.HeightRequest>
                            <OnPlatform x:TypeArguments="system:Double">
                                <On Platform="iOS"     Value="0"/>
                                <On Platform="Android" Value="50"/>
                            </OnPlatform>
                        </BoxView.HeightRequest>
                    </BoxView>
                </Grid>
                <!--#endregion-->
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>